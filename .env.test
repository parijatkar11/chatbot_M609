# Automated-test profile. Uses local-only settings and no external credentials.
APP_ENV=test
APP_NAME=Mortgage Chatbot (Tests)
APP_VERSION=1.0.0
APP_DESCRIPTION=Mortgage chatbot automated test API

API_HOST=127.0.0.1
API_PORT=8001
API_DEBUG=false
API_LOG_LEVEL=warning
API_BASE_URL=
API_CORS_ORIGINS=http://127.0.0.1:8502,http://localhost:8502
API_DOCS_ENABLED=false
API_REQUEST_TIMEOUT=2
API_STATS_TIMEOUT=2
API_CUSTOMER_TIMEOUT=2
MAX_INPUT_LENGTH=5000

OPENAI_API_KEY=
MODEL_NAME=test-model
MODEL_TEMPERATURE=0
MODEL_TEMPERATURE_MIN=0.0
MODEL_TEMPERATURE_MAX=2.0
MODEL_TEMPERATURE_STEP=0.1
MODEL_MAX_TOKENS=100
MODEL_MAX_TOKENS_MIN=50
MODEL_MAX_TOKENS_MAX=2000
MODEL_MAX_TOKENS_STEP=50

STREAMLIT_PORT=8502
STREAMLIT_PAGE_TITLE=Mortgage Chatbot (Tests)
STREAMLIT_PAGE_ICON=🧪
STREAMLIT_LAYOUT=centered
STREAMLIT_SIDEBAR_STATE=collapsed
STREAMLIT_HIL_ENABLED=false
STREAMLIT_HIL_TIMEOUT_MIN=1
STREAMLIT_HIL_TIMEOUT_MAX=5
STREAMLIT_HIL_TIMEOUT_DEFAULT=2
STREAMLIT_HIL_TIMEOUT_STEP=1

LANGGRAPH_DEBUG=false
LANGGRAPH_TIMEOUT=5
