# Local development profile. Keep credentials out of source control.
APP_ENV=dev
APP_NAME=Mortgage Chatbot (Development)
APP_VERSION=1.0.0
APP_DESCRIPTION=Mortgage chatbot development API

API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=true
API_LOG_LEVEL=debug
API_BASE_URL=
API_CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
API_DOCS_ENABLED=true
API_REQUEST_TIMEOUT=30
API_STATS_TIMEOUT=10
API_CUSTOMER_TIMEOUT=5
MAX_INPUT_LENGTH=5000

OPENAI_API_KEY=
MODEL_NAME=gpt-4
MODEL_TEMPERATURE=0.7
MODEL_TEMPERATURE_MIN=0.0
MODEL_TEMPERATURE_MAX=2.0
MODEL_TEMPERATURE_STEP=0.1
MODEL_MAX_TOKENS=500
MODEL_MAX_TOKENS_MIN=50
MODEL_MAX_TOKENS_MAX=2000
MODEL_MAX_TOKENS_STEP=50

STREAMLIT_PORT=8501
STREAMLIT_PAGE_TITLE=Mortgage Chatbot (Development)
STREAMLIT_PAGE_ICON=🏦
STREAMLIT_LAYOUT=wide
STREAMLIT_SIDEBAR_STATE=expanded
STREAMLIT_HIL_ENABLED=false
STREAMLIT_HIL_TIMEOUT_MIN=30
STREAMLIT_HIL_TIMEOUT_MAX=300
STREAMLIT_HIL_TIMEOUT_DEFAULT=120
STREAMLIT_HIL_TIMEOUT_STEP=30

LANGGRAPH_DEBUG=true
LANGGRAPH_TIMEOUT=60
